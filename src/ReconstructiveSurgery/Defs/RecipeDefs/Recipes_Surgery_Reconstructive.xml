  </RecipeDef>

  <RecipeDef ParentName="SurgeryScarBase">
    <defName>FullReconstruction</defName>
    <label>plan full reconstruction</label>
    <description>Survey every scar and queue one operation bill per treatable part: revision,
      grafting, facial work, and bone correction each as its own bill. Adding this bill replaces it
      with the individual operations.</description>
    <jobString>Planning full reconstruction.</jobString>
    <workAmount>500</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <successfullyRemovedHediffMessage>{0} has fully reconstructed {1}.</successfullyRemovedHediffMessage>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="ReconstructiveSurgery.SurgeryScarExtension">
        <allowedInjuryDefs>
          <li>Misc</li>
          <li>Cut</li>
          <li>Scratch</li>
          <li>Stab</li>
          <li>Bite</li>
          <li>SurgicalCut</li>
          <li>Burn</li>
          <li>ChemicalBurn</li>
          <li>ElectricalBurn</li>
          <li>AcidBurn</li>
          <li>Frostbite</li>
          <li>Crush</li>
          <li>Gunshot</li>
          <li>Shredded</li>
          <li>Crack</li>
        </allowedInjuryDefs>
        <requireOutsideOnly>false</requireOutsideOnly>
