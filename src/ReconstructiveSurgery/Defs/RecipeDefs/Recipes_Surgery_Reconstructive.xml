  </RecipeDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>AestheticContouring</defName>
    <label>aesthetic contouring</label>
    <description>Cosmetic soft-tissue augmentation with fat grafting and dermal reshaping. Slightly
      increases beauty. No medical benefit, carries full surgical risk.</description>
    <workerClass>Recipe_AddHediff</workerClass>
    <jobString>Performing aesthetic contouring.</jobString>
    <workAmount>4000</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <isViolation>false</isViolation>
    <targetsBodyPart>false</targetsBodyPart>
    <addsHediff>ReconstructiveContouring</addsHediff>
    <deathOnFailedSurgeryChance>0.02</deathOnFailedSurgeryChance>
    <skillRequirements>
      <Medicine>10</Medicine>
    </skillRequirements>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
      <disallowedThingDefs>
        <li>MedicineHerbal</li>
        <li>MedicineIndustrial</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryScarBase">
    <defName>RepairOrganScarring</defName>
    <label>repair organ scarring</label>
    <description>Cut the scarring out of a failing organ with the patient open on the table. Very
      risky surgery, honestly you would be better off finding a "willing" donor and transplanting a
      fresh one instead. Takes the better part of a day, failure wounds but never kills.</description>
    <jobString>Repairing organ scarring.</jobString>
    <workAmount>20000</workAmount>
    <successfullyRemovedHediffMessage>{0} has successfully repaired scarring in {1}'s organ.</successfullyRemovedHediffMessage>
    <surgerySuccessChanceFactor>1.0</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <skillRequirements>
      <Medicine>12</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
      <disallowedThingDefs>
        <li>MedicineHerbal</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="ReconstructiveSurgery.SurgeryScarExtension">
        <allowedInjuryDefs>
          <li>Misc</li>
          <li>Cut</li>
          <li>Scratch</li>
          <li>Stab</li>
          <li>Bite</li>
          <li>SurgicalCut</li>
          <li>Burn</li>
          <li>ChemicalBurn</li>
          <li>ElectricalBurn</li>
          <li>AcidBurn</li>
          <li>Frostbite</li>
          <li>Crush</li>
          <li>Gunshot</li>
          <li>Shredded</li>
          <li>Crack</li>
        </allowedInjuryDefs>
        <requireOutsideOnly>false</requireOutsideOnly>
        <requireInsideOnly>true</requireInsideOnly>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>ReconstructNose</defName>
    <label>reconstruct nose</label>
    <description>Rebuild a lost nose from the patient's own skin and cartilage, forehead flap and
      all. Ends disfigurement, but it will never smell like the real thing.</description>
    <workerClass>ReconstructiveSurgery.Recipe_ReconstructNose</workerClass>
    <jobString>Reconstructing nose.</jobString>
    <workAmount>2000</workAmount>
    <successfullyRemovedHediffMessage>{0} has successfully reconstructed {1}'s nose.</successfullyRemovedHediffMessage>
    <surgerySuccessChanceFactor>1.0</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <skillRequirements>
      <Medicine>7</Medicine>
    </skillRequirements>
    <appliedOnFixedBodyParts>
      <li>Nose</li>
    </appliedOnFixedBodyParts>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
      <disallowedThingDefs>
        <li>MedicineHerbal</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

</Defs>