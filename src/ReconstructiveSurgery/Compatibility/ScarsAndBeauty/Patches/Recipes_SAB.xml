<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Scars and Beauty compatibility (MadExOff.ScarsAndBeauty). Loaded only when S&B is active (see LoadFolders.xml IfModActive). Ingredient mapping proposed by Jovini on Steam. S&B defNames verified against ScarsAndBeauty 1.6: SAB_InsectaMed, SAB_InsectoGel, SAB_Collagenesis, SAB_Agavecine. Research: ResearchProjectIndustrialMeds (simple scar removal), ResearchProjectSpacerMeds (advanced scar removal). Plan Full Reconstruction (FullReconstruction) intentionally unchanged: it expands into the individual bills, which carry the new costs. -->

  <!-- Revise Scar: 1x Standard Medicine + 1x Insectamed OR Insectogel. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ReviseScar"]/ingredients</xpath>
    <value>
      <ingredients>
        <li>
          <filter>
            <thingDefs>
              <li>MedicineIndustrial</li>
            </thingDefs>
          </filter>
          <count>1</count>
        </li>
        <li>
          <filter>
            <thingDefs>
              <li>SAB_InsectaMed</li>
              <li>SAB_InsectoGel</li>
            </thingDefs>
          </filter>
          <count>1</count>
        </li>
      </ingredients>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ReviseScar"]/fixedIngredientFilter</xpath>
    <value>
      <fixedIngredientFilter>
        <categories>
          <li>Medicine</li>
        </categories>
        <disallowedThingDefs>
          <li>MedicineHerbal</li>
        </disallowedThingDefs>
        <thingDefs>
          <li>SAB_InsectaMed</li>
          <li>SAB_InsectoGel</li>
        </thingDefs>
      </fixedIngredientFilter>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="ReviseScar"]</xpath>
    <value>
      <researchPrerequisite>ResearchProjectIndustrialMeds</researchPrerequisite>
    </value>
  </Operation>

