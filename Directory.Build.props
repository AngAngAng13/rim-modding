<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>8.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(MSBuildProjectDirectory)\obj\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <ModVersion Condition="'$(ModVersion)' == ''">1.0.0</ModVersion>
    <AssemblyVersion>$(ModVersion)</AssemblyVersion>
    <FileVersion>$(ModVersion)</FileVersion>
    <InformationalVersion>$(ModVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <WorkspaceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\\..'))</WorkspaceRoot>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and Exists('$(WorkspaceRoot)\\RimWorld')">$(WorkspaceRoot)\RimWorld</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <GameModsDir Condition="'$(GameModsDir)' == ''">$(RimWorldDir)\Mods</GameModsDir>
    <Error Condition="!Exists('$(RimWorldDir)')">RimWorldDir '$(RimWorldDir)' not found. Set the RIMWORLD_DIR environment variable.</Error>
  </PropertyGroup>
</Project>
